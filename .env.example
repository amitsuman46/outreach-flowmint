# SQLite file, created by `npm run db:push`. Path is relative to prisma/.
DATABASE_URL="file:./dev.db"

# Desk login. Change both before anyone else can open the app.
JWT_SECRET="change-me-to-a-long-random-string"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"

# OpenAI. Prepare (fit, site review, concept, draft) stays off until this is set.
OPENAI_API_KEY=
# Fit checks and site reviews.
OPENAI_MODEL=gpt-5.4-mini
# Text the lead reads: the email, the proposal, the concept page.
OPENAI_WRITING_MODEL=gpt-5.4

# Hostinger business mailbox used only for cold email.
# Website-enquiry mail from other apps should use a different address.
OUTREACH_SMTP_HOST=smtp.hostinger.com
OUTREACH_SMTP_PORT=465
OUTREACH_SMTP_USER=
OUTREACH_SMTP_PASSWORD=
OUTREACH_IMAP_HOST=imap.hostinger.com
OUTREACH_IMAP_PORT=993
# Optional. Defaults to the SMTP user and password.
OUTREACH_IMAP_USER=
OUTREACH_IMAP_PASSWORD=
# Sender name shown in the recipient's inbox, e.g. "Amit · FlowMint".
OUTREACH_FROM_NAME=

# Email signature. Company and website default to FlowMint and https://flowmint.works.
SIGNATURE_NAME=
SIGNATURE_TITLE=
SIGNATURE_PHONE=
# Optional. Defaults to the FlowMint logo hosted on the concept site.
SIGNATURE_LOGO_URL=

# Concept site on Netlify's free plan. Create a personal access token at
# Netlify → User settings → Applications → Personal access tokens.
# The site is created on first publish as https://<NETLIFY_SITE>.netlify.app.
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE=flowmint-demos
